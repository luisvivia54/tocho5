<?xml version="1.0" encoding="UTF-8"?>
<configuration>

  <!--
    Patrón que incluye el requestId puesto por RequestIdFilter.
    Si no hay requestId (ej. logs de startup), aparece "-".
  -->
  <property name="CONSOLE_LOG_PATTERN"
    value="%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] [req=%X{requestId:-}] %logger{36} - %msg%n"/>

  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>${CONSOLE_LOG_PATTERN}</pattern>
    </encoder>
  </appender>

  <root level="INFO">
    <appender-ref ref="CONSOLE"/>
  </root>

  <!-- Niveles por paquete -->
  <logger name="com.ks.tocho5" level="INFO"/>
  <logger name="org.hibernate.SQL" level="WARN"/>
  <logger name="org.springframework.security" level="INFO"/>
  <logger name="org.springframework.web" level="INFO"/>

</configuration>
