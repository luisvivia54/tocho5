# ============================================================
# .env.example  -  copia a .env y llena los valores
# El backend de tocho5 los lee vía application.properties
# ============================================================

# --- Base de datos ---
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/tocho5
SPRING_DATASOURCE_USERNAME=tocho5
SPRING_DATASOURCE_PASSWORD=CAMBIAME

# --- Cloudflare R2 (rota las credenciales viejas que estaban en git) ---
R2_ENDPOINT=https://7187a6b46cc1b545de37d29582df1592.r2.cloudflarestorage.com
R2_BUCKET_NAME=tocho5-dev
R2_ACCESS_KEY_ID=CAMBIAME
R2_SECRET_ACCESS_KEY=CAMBIAME
R2_PUBLIC_BASE_URL=https://media.tochero5.mx

# --- Keycloak (Resource Server + Admin Client) ---
KEYCLOAK_ISSUER_URI=https://auth.tochero5.mx/realms/tochero5
KEYCLOAK_ADMIN_SERVER_URL=https://auth.tochero5.mx
KEYCLOAK_ADMIN_REALM=tochero5
KEYCLOAK_ADMIN_CLIENT_ID=tocho5-admin-service
KEYCLOAK_ADMIN_CLIENT_SECRET=CAMBIAME

# opcional (timeouts en ms)
KEYCLOAK_ADMIN_CONNECT_TIMEOUT=5000
KEYCLOAK_ADMIN_READ_TIMEOUT=10000
